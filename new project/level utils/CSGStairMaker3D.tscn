[sub_resource type="GDScript" id="GDScript_0eugj"]
script/source = "@tool
extends CSGBox3D

# extended from somewhere online (i forget the source i've had it for ages)

@onready var stairs_poly: CSGPolygon3D = $StairsSubtractCSG
@onready var bottom_poly: CSGPolygon3D = $BottomSubtractCSG

@export_range(0, 999, 1) var num_stairs : int = 10:
	set(value):
		num_stairs = value
		if stairs_poly == null or bottom_poly == null:
			await self.ready
		make_stairs()

@export_range(0, 100, 0.01, \"hide_control\", \"or_greater\") var bottom_cut_up: float:
	set(value):
		bottom_cut_up = value
		if stairs_poly == null or bottom_poly == null:
			await self.ready
		make_stairs()
@export_range(0, 100, 0.01, \"hide_control\", \"or_greater\") var bottom_cut_over: float:
	set(value):
		bottom_cut_over = value
		if stairs_poly == null or bottom_poly == null:
			await self.ready
		make_stairs()

#var _cur_num_stairs = -1
var _cur_size : Vector3

func make_stairs():
	#if not Engine.is_editor_hint():
		#return
	#
	#num_stairs = clampi(num_stairs, 0, 999)
	var cut_y = clamp(bottom_cut_up, 0, self.size.y)
	var cut_x = self.size.x - clamp(bottom_cut_over, 0, self.size.x)
	
	var point_arr : PackedVector2Array = PackedVector2Array()
	var step_height = self.size.y / num_stairs
	var step_width = self.size.x / num_stairs
	
	if num_stairs == 0:
		# For 0 stairs make a ramp
		point_arr.append(Vector2(self.size.x, self.size.y))
		point_arr.append(Vector2(0, self.size.y))
		point_arr.append(Vector2(0, 0))
	else:
		# Creating the points for the stairs polygon
		for i in range(num_stairs - 1):
			point_arr.append(Vector2(i * step_width, (i + 1) * step_height))
			if i < num_stairs:
				point_arr.append(Vector2((i + 1) * step_width, (i + 1) * step_height))

		# Closing the polygon by adding the last two points
		point_arr.append(Vector2(self.size.x - step_width, self.size.y))
		point_arr.append(Vector2(0, self.size.y))
	stairs_poly.polygon = point_arr
	
	var point_arr2 : PackedVector2Array = PackedVector2Array()
	point_arr2.append(Vector2(cut_x, -0.5))
	point_arr2.append(Vector2(cut_x, 0))
	point_arr2.append(Vector2(self.size.x, cut_y))
	point_arr2.append(Vector2(self.size.x + 0.5, cut_y))
	point_arr2.append(Vector2(self.size.x + 0.5, -0.5))
	bottom_poly.polygon = point_arr2
	
	stairs_poly.depth = self.size.z * 2
	bottom_poly.depth = self.size.z * 2
	
	stairs_poly.position.z = self.size.z / 2.0 + 0.5 * self.size.z
	stairs_poly.position.y = -self.size.y / 2.0
	stairs_poly.position.x = -self.size.x / 2.0
	bottom_poly.position = stairs_poly.position

	#_cur_num_stairs = num_stairs
	_cur_size = self.size

func _ready() -> void:
	make_stairs()

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(_delta):
	if _cur_size != self.size:
		if stairs_poly != null and bottom_poly != null:
			make_stairs()
"

